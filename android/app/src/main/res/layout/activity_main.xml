<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/txt_latido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sin_datos_esp32"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_alerta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/rojo"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Nivel -->
        <TextView style="@style/Etiqueta" android:text="@string/nivel" />
        <TextView android:id="@+id/txt_nivel" style="@style/Valor" />
        <TextView android:id="@+id/txt_nivel_detalle" style="@style/Detalle" />
        <TextView android:id="@+id/txt_motivo" style="@style/Detalle" />

        <!-- Cámara -->
        <TextView style="@style/Etiqueta" android:text="@string/camara" />
        <TextView android:id="@+id/txt_camara" style="@style/Valor" />
        <TextView android:id="@+id/txt_humedad" style="@style/Detalle" />

        <!-- Bloque -->
        <TextView style="@style/Etiqueta" android:text="@string/bloque" />
        <TextView android:id="@+id/txt_bloque" style="@style/Valor" />
        <TextView android:id="@+id/txt_fuga" style="@style/Detalle" />

        <!-- Objetivo (umbral dinámico del Proyecto 1) -->
        <TextView style="@style/Etiqueta" android:text="@string/objetivo" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_menos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="−" />

            <TextView
                android:id="@+id/txt_objetivo"
                style="@style/Valor"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="center" />

            <Button
                android:id="@+id/btn_mas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
