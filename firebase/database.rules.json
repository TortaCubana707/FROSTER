{
  "rules": {
    "froster": {
      ".read": "auth != null",
      "lecturas": {
        ".write": "auth != null && root.child('roles').child(auth.uid).val() === 'admin'",
        "$clave": {
          ".validate": "newData.isNumber()"
        }
      },
      "estado": {
        ".write": "auth != null && root.child('roles').child(auth.uid).val() === 'admin'",
        "nivel": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
        },
        "celda_a": {
          ".validate": "newData.isBoolean()"
        },
        "celda_b": {
          ".validate": "newData.isBoolean()"
        },
        "bomba": {
          ".validate": "newData.isBoolean()"
        },
        "pwm_fans": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        },
        "setpoint": {
          ".validate": "newData.isNumber()"
        },
        "modo": {
          ".validate": "newData.isString()"
        },
        "motivo": {
          ".validate": "newData.isString()"
        },
        "alerta": {
          ".validate": "newData.isString()"
        },
        "alerta_id": {
          ".validate": "newData.isNumber()"
        },
        "condensa": {
          ".validate": "newData.isBoolean()"
        },
        "carga_alta": {
          ".validate": "newData.isBoolean()"
        },
        "uptime_s": {
          ".validate": "newData.isNumber()"
        },
        "$otra": {
          ".validate": false
        }
      },
      "config": {
        "setpoint": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && newData.val() >= 15 && newData.val() <= 40"
        },
        "modo": {
          ".write": "auth != null && root.child('roles').child(auth.uid).val() === 'admin'",
          ".validate": "newData.isString() && newData.val().matches(/^(auto|manual|off)$/)"
        },
        "manual_a": {
          ".write": "auth != null && root.child('roles').child(auth.uid).val() === 'admin'",
          ".validate": "newData.isBoolean()"
        },
        "manual_b": {
          ".write": "auth != null && root.child('roles').child(auth.uid).val() === 'admin'",
          ".validate": "newData.isBoolean()"
        },
        "carga_alta": {
          ".write": "auth != null && root.child('roles').child(auth.uid).val() === 'admin'",
          ".validate": "newData.isBoolean()"
        },
        "cmd_id": {
          ".write": "auth != null",
          ".validate": "newData.isNumber()"
        },
        "$otra": {
          ".validate": false
        }
      },
      "ack": {
        ".write": "auth != null && root.child('roles').child(auth.uid).val() === 'admin'",
        "$clave": {
          ".validate": "newData.isNumber()"
        }
      },
      "dispositivo": {
        ".write": "auth != null && root.child('roles').child(auth.uid).val() === 'admin'",
        "ip": {
          ".validate": "newData.isString()"
        },
        "firmware": {
          ".validate": "newData.isString()"
        },
        "rssi": {
          ".validate": "newData.isNumber()"
        },
        "caidas_wifi": {
          ".validate": "newData.isNumber()"
        },
        "ultima_conexion": {
          ".validate": "newData.isNumber()"
        },
        "$otra": {
          ".validate": false
        }
      },
      "eventos": {
        ".write": "auth != null && root.child('roles').child(auth.uid).val() === 'admin'",
        ".indexOn": [
          "ts"
        ],
        "$evento": {
          ".validate": "newData.hasChildren(['tipo', 'texto', 'ts'])",
          "tipo": {
            ".validate": "newData.isString() && newData.val().matches(/^(nivel|alerta|pico)$/)"
          },
          "texto": {
            ".validate": "newData.isString()"
          },
          "nivel": {
            ".validate": "newData.isNumber()"
          },
          "camara": {
            ".validate": "newData.isNumber()"
          },
          "setpoint": {
            ".validate": "newData.isNumber()"
          },
          "ts": {
            ".validate": "newData.isNumber()"
          },
          "$otra": {
            ".validate": false
          }
        }
      }
    },
    "roles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    }
  }
}
