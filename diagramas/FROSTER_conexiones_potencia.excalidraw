   "text": "Diodo 1N4007 entre los\ncables de la bomba:\nfranja → rojo (+)",
   "originalText": "Diodo 1N4007 entre los\ncables de la bomba:\nfranja → rojo (+)",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "type": "text",
   "id": "tex222",
   "x": 1720,
   "y": 1100,
   "width": 285.59999999999997,
   "height": 52.5,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 87393516,
   "version": 1,
   "versionNonce": 95156300,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Rojos: al +12V.\nNegros: a LOAD del D4184 #3.\nLos 4 en paralelo: ≈1.0A en total.",
   "originalText": "Rojos: al +12V.\nNegros: a LOAD del D4184 #3.\nLos 4 en paralelo: ≈1.0A en total.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "type": "text",
   "id": "tex223",
   "x": 1720,
   "y": 1240,
   "width": 226.79999999999998,
   "height": 35.0,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 71932209,
   "version": 1,
   "versionNonce": 11769529,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Flechas de los ventiladores\nen la misma dirección",
   "originalText": "Flechas de los ventiladores\nen la misma dirección",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
