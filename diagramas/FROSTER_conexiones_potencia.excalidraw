  {
   "type": "text",
   "id": "tex225",
   "x": 980,
   "y": 1474,
   "width": 374.4,
   "height": 20.0,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 39644605,
   "version": 1,
   "versionNonce": 9270097,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Así es cada D4184 (como el de tu foto):",
   "originalText": "Así es cada D4184 (como el de tu foto):",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "type": "text",
   "id": "tex226",
   "x": 980,
   "y": 1504,
   "width": 764.4,
   "height": 70.0,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 21936081,
   "version": 1,
   "versionNonce": 54296836,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "· bornera azul:  +  = +12V   ·   LOAD = negativo de lo que enciende   ·   − = tierra de 12V\n· bornera verde: PWM ← S del ESP32   ·   GND ← G del ESP32\n· la verde está aislada (optoacoplador): NO se une con la tierra de 12V\n· su + necesita 6V o más: por eso va en los 12V, antes del XL4016",
   "originalText": "· bornera azul:  +  = +12V   ·   LOAD = negativo de lo que enciende   ·   − = tierra de 12V\n· bornera verde: PWM ← S del ESP32   ·   GND ← G del ESP32\n· la verde está aislada (optoacoplador): NO se une con la tierra de 12V\n· su + necesita 6V o más: por eso va en los 12V, antes del XL4016",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "type": "rectangle",
